import serial
import time

PORT = '/dev/ttyACM0'
BAUD_RATE = 9600

try:
    ser = serial.Serial(PORT, BAUD_RATE, timeout=2)
    time.sleep(2)  # Wait for Arduino boot stabilization
    print("Arduino serial communication connected successfully!")
except Exception as e:
    print(f"Connection error: {e}")
    exit()

def send_command(command):
    ser.write((command + '\n').encode('utf-8'))
    time.sleep(0.1)
    if ser.in_waiting > 0:
        return ser.readline().decode('utf-8').strip()
    return None

# Main automatic control loop for smart window
try:
    while True:
        # 1. Request sensor data from Arduino
        response = send_command("GET_SENSOR")
        print(f"\n[Sensor Response Received]: {response}")
       
        # 2. Data parsing and automatic window control logic
        if response and "TEMP:" in response:
            try:
                # Example format: TEMP:24.5,HUMI:60.0,RAIN:1,DUST:150
                parts = response.split(',')
                temp = float(parts[0].split(':')[1])
                humi = float(parts[1].split(':')[1])
                rain = int(parts[2].split(':')[1])
                dust = int(parts[3].split(':')[1])
               
                print(f"Temp: {temp}C | Humidity: {humi}% | Rain: {rain} | Dust: {dust}")
               
                # Automated control logic based on weather conditions
                # (Note: Rain sensor logic may vary depending on active-low/high relay module)
                if rain == 0:  
                    print("-> Rain detected! Closing window immediately.")
                    print(f"Arduino Response: {send_command('WINDOW_CLOSE')}")
                elif dust > 300:  # Example high dust threshold
                    print("-> High dust level! Closing window.")
                    print(f"Arduino Response: {send_command('WINDOW_CLOSE')}")
                else:
                    print("-> Weather is safe. Opening window.")
                    print(f"Arduino Response: {send_command('WINDOW_OPEN')}")
                   
            except Exception as parse_err:
                print(f"Data parsing error: {parse_err}")
       
        # Monitor sensor status every 5 seconds
        time.sleep(5)

except KeyboardInterrupt:
    ser.close()
    print("\nProgram safely terminated.")
