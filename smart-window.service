# 설치: sudo cp smart-window.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now smart-window
# 확인: systemctl status smart-window / journalctl -u smart-window -f
# 아래 User, WorkingDirectory, ExecStart 경로는 본인 환경에 맞게 수정하세요.
[Unit]
Description=Smart Window Controller
After=network.target

[Service]
Type=simple
User=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/smart_window
ExecStart=/usr/bin/python3 /home/pi/smart_window/server.py
# 아두이노가 인식되는 포트. 포트 번호가 바뀌는 문제를 피하려면 /dev/serial/by-id/ 아래 경로 사용 권장
Environment=SW_SERIAL_PORT=/dev/ttyACM0
# 창문이 끝까지 열리/닫히는 실측 시간(초). 아두이노 MAX_RUN_MS(8초)보다 짧아야 함
Environment=SW_MOVE_SECONDS=5
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# 종료 시 모터 정지 확인(shutdown_stop)을 할 시간을 준다
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
